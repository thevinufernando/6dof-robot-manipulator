<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gp7_motion</name>
  <version>0.1.0</version>
  <description>Trajectory planning for the YASKAWA GP7: trapezoidal / S-curve profiles, Cartesian paths with constant orientation, pick and place.</description>
  <maintainer email="user@todo.todo">todo</maintainer>
  <license>MIT</license>

  <exec_depend>gp7_kinematics</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
