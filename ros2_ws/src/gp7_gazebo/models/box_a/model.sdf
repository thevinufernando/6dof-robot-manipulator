<?xml version="1.0"?>
<!--
  Box A: 30 cm x 30 cm x 20 cm, static (it is the "table" Box B is placed on).
  Model origin = centre of the BOTTOM face, so spawning at (x, y, 0) puts it on
  the ground at (x, y). Top-face centre = (x, y, 0.20).
-->
<sdf version="1.9">
  <model name="box_a">
    <static>true</static>
    <link name="link">
      <pose>0 0 0.10 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.30 0.30 0.20</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.30 0.30 0.20</size></box></geometry>
        <material>
          <ambient>0.60 0.45 0.25 1</ambient>
          <diffuse>0.60 0.45 0.25 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
