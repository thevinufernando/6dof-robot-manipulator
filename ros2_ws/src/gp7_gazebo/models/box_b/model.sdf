<?xml version="1.0"?>
<!--
  Box B: 5 cm cube, 0.1 kg, picked up by the GP7.
  Model origin = centre of the BOTTOM face, so spawning at (x, y, 0) puts it on
  the ground at (x, y); its centre is then at (x, y, 0.025).

  PosePublisher publishes the model pose on /model/box_b/pose (gz.msgs.Pose),
  bridged to ROS as /box_b/pose, so the planner can read where Box B is.
-->
<sdf version="1.9">
  <model name="box_b">
    <link name="link">
      <pose>0 0 0.025 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <!-- solid cube: I = m a^2 / 6 -->
        <inertia>
          <ixx>4.1667e-5</ixx><iyy>4.1667e-5</iyy><izz>4.1667e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        <material>
          <ambient>0.85 0.10 0.10 1</ambient>
          <diffuse>0.85 0.10 0.10 1</diffuse>
        </material>
      </visual>
    </link>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>10</update_frequency>
    </plugin>
  </model>
</sdf>
