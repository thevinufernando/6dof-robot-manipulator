<?xml version="1.0"?>
<!--
  Gazebo (gz-sim Harmonic) extras for the GP7.

  Without a controller the arm would collapse under gravity. This mode uses
  plain Gazebo systems (no ROS involved):

  * JointStatePublisher      - publishes joint angles on
                               /world/<world>/model/gp7/joint_state
                               (bridged to ROS /joint_states by gp7_gazebo).
  * JointPositionController  - one per joint, holds the home pose. In velocity
                               mode the joint moves to its target at up to
                               cmd_max (set to the datasheet max speed).
                               Poke a joint from a terminal, e.g.
                               gz topic -t /gp7/joint_2_l/cmd_pos -m gz.msgs.Double -p 'data: 0.5'

  This file is only used with sim_control:=gz_plugins (Gazebo-only control,
  no ros2_control). The default, sim_control:=ros2_control, uses
  gp7.ros2_control.xacro instead.

  Gripper: each finger has a force-mode (PID) JointPositionController; both
  listen to the same topic, so one number moves both fingers symmetrically:
      gz topic -t /gp7/gripper/cmd_pos -m gz.msgs.Double -p 'data: 0.0425'   # close
      gz topic -t /gp7/gripper/cmd_pos -m gz.msgs.Double -p 'data: 0.0'      # open
  (also bridged from ROS: ros2 topic pub /gp7/gripper/cmd_pos std_msgs/msg/Float64 ...)
  When a finger is blocked by an object its PID saturates at the effort limit
  (config/gripper.yaml), which is the grip force.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Hold one joint at its commanded position (Gazebo-only controller). -->
  <xacro:macro name="gz_hold_joint" params="prefix name">
    <gazebo>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>${prefix}${name}</joint_name>
        <topic>/gp7/${prefix}${name}/cmd_pos</topic>
        <use_velocity_commands>true</use_velocity_commands>
        <cmd_max>${radians(lim[name]['velocity_deg_s'])}</cmd_max>
        <cmd_min>${-radians(lim[name]['velocity_deg_s'])}</cmd_min>
        <initial_position>0.0</initial_position>
      </plugin>
    </gazebo>
  </xacro:macro>

  <!-- Drive one gripper finger. Both fingers' controllers listen to the SAME
       topic, so one number moves both symmetrically.
       FORCE (PID) mode, not velocity mode: with all six arm joints already
       velocity-controlled, velocity-commanded fingers were not tracked reliably
       (one finger stuck, depending on the arm orientation). A single controller
       with two <joint_name> tags is not used either: it computes its command
       from the first joint's error only. -->
  <xacro:macro name="gz_finger" params="prefix side">
    <gazebo>
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>${prefix}gripper_${side}_finger_joint</joint_name>
        <topic>/gp7/${prefix}gripper/cmd_pos</topic>
        <use_velocity_commands>false</use_velocity_commands>
        <p_gain>${grp['control']['p_gain']}</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>${grp['control']['d_gain']}</d_gain>
        <cmd_max>${grp['effort']}</cmd_max>
        <cmd_min>${-grp['effort']}</cmd_min>
        <initial_position>0.0</initial_position>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="gp7_gazebo" params="prefix:='' gz_hold:=true gripper:=true">
    <gazebo>
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher"/>
    </gazebo>

    <xacro:if value="${gz_hold}">
      <xacro:gz_hold_joint prefix="${prefix}" name="joint_1_s"/>
      <xacro:gz_hold_joint prefix="${prefix}" name="joint_2_l"/>
      <xacro:gz_hold_joint prefix="${prefix}" name="joint_3_u"/>
      <xacro:gz_hold_joint prefix="${prefix}" name="joint_4_r"/>
      <xacro:gz_hold_joint prefix="${prefix}" name="joint_5_b"/>
      <xacro:gz_hold_joint prefix="${prefix}" name="joint_6_t"/>
    </xacro:if>

    <xacro:if value="${gripper}">
      <xacro:gz_finger prefix="${prefix}" side="left"/>
      <xacro:gz_finger prefix="${prefix}" side="right"/>
    </xacro:if>
    <!-- Note: self-collision is off by default in Gazebo, which we want here
         because neighbouring convex-hull collision meshes overlap. -->
  </xacro:macro>
</robot>
