<?xml version="1.0"?>
<!--
  Simplified 2-finger parallel gripper (Robotiq 2F-85 style), built from boxes
  and a cylinder. Dimensions: config/gripper.yaml.

  gripper_base  (fixed to the parent, normally tool0 = DH frame {6})
   |- gripper_left_finger_joint   prismatic, +Y side, axis -Y (positive q closes)
   |- gripper_right_finger_joint  prismatic, -Y side, axis +Y, <mimic> of the left
   '- gripper_tcp                 fixed, tool centre point between the pads

  mimic:=true adds a <mimic> tag so RViz / joint_state_publisher treat the
  gripper as ONE degree of freedom (one slider). Gazebo's DART engine does not
  support mimic constraints, so for Gazebo (mimic:=false) each finger has its
  own controller, both listening to the same command topic (gp7.gazebo.xacro),
  and Gazebo publishes both finger joint states itself.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="grp" value="${xacro.load_yaml('$(find gp7_description)/config/gripper.yaml')}"/>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m * (y*y + z*z) / 12}" ixy="0" ixz="0"
             iyy="${m * (x*x + z*z) / 12}" iyz="0" izz="${m * (x*x + y*y) / 12}"/>
  </xacro:macro>

  <!-- One finger. s = +1 (left, +Y side) or -1 (right, -Y side).
       Finger frame: on the pad's inner face, at the bottom of the body.
       Geometry hangs along +Z; the finger plate sits outboard of the pad. -->
  <xacro:macro name="gripper_finger" params="prefix side s mimic">
    <xacro:property name="f" value="${grp['finger']}"/>
    <xacro:property name="y_plate" value="${s * (f['pad_thickness'] + f['thickness_y'] / 2)}"/>
    <xacro:property name="y_pad" value="${s * f['pad_thickness'] / 2}"/>
    <xacro:property name="z_pad" value="${f['length_z'] - f['pad_length'] / 2}"/>
    <link name="${prefix}gripper_${side}_finger">
      <visual>
        <origin xyz="0 ${y_plate} ${f['length_z'] / 2}"/>
        <geometry><box size="${f['width_x']} ${f['thickness_y']} ${f['length_z']}"/></geometry>
        <material name="${prefix}gripper_finger_material"><color rgba="0.20 0.20 0.22 1"/></material>
      </visual>
      <visual>
        <origin xyz="0 ${y_pad} ${z_pad}"/>
        <geometry><box size="${f['width_x']} ${f['pad_thickness']} ${f['pad_length']}"/></geometry>
        <material name="${prefix}gripper_pad_material"><color rgba="0.05 0.05 0.05 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 ${y_plate} ${f['length_z'] / 2}"/>
        <geometry><box size="${f['width_x']} ${f['thickness_y']} ${f['length_z']}"/></geometry>
      </collision>
      <collision>
        <origin xyz="0 ${y_pad} ${z_pad}"/>
        <geometry><box size="${f['width_x']} ${f['pad_thickness']} ${f['pad_length']}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 ${y_plate} ${f['length_z'] / 2}"/>
        <mass value="${f['mass']}"/>
        <xacro:box_inertia m="${f['mass']}" x="${f['width_x']}" y="${f['thickness_y'] + f['pad_thickness']}" z="${f['length_z']}"/>
      </inertial>
    </link>

    <joint name="${prefix}gripper_${side}_finger_joint" type="prismatic">
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}gripper_${side}_finger"/>
      <!-- q = 0: pad face at s * stroke (open); q = stroke: pad face at Y = 0 (closed) -->
      <origin xyz="0 ${s * grp['stroke']} ${grp['coupling']['length'] + grp['body']['z']}" rpy="0 0 0"/>
      <axis xyz="0 ${-s} 0"/>
      <limit lower="0.0" upper="${grp['stroke']}" velocity="${grp['velocity']}" effort="${grp['effort']}"/>
      <dynamics damping="1.0" friction="0.0"/>
      <xacro:if value="${s &lt; 0 and mimic}">
        <mimic joint="${prefix}gripper_left_finger_joint" multiplier="1" offset="0"/>
      </xacro:if>
    </joint>

    <!-- High-friction finger pads in Gazebo -->
    <gazebo reference="${prefix}gripper_${side}_finger">
      <mu1>${f['friction_mu']}</mu1>
      <mu2>${f['friction_mu']}</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="gripper_2f" params="prefix:='' parent mimic:=true">
    <xacro:property name="c" value="${grp['coupling']}"/>
    <xacro:property name="b" value="${grp['body']}"/>

    <joint name="${prefix}${parent}-gripper_base" type="fixed">
      <parent link="${prefix}${parent}"/>
      <child link="${prefix}gripper_base"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}gripper_base">
      <visual>
        <origin xyz="0 0 ${c['length'] / 2}"/>
        <geometry><cylinder radius="${c['radius']}" length="${c['length']}"/></geometry>
        <material name="${prefix}gripper_coupling_material"><color rgba="0.55 0.57 0.60 1"/></material>
      </visual>
      <visual>
        <origin xyz="0 0 ${c['length'] + b['z'] / 2}"/>
        <geometry><box size="${b['x']} ${b['y']} ${b['z']}"/></geometry>
        <material name="${prefix}gripper_body_material"><color rgba="0.15 0.15 0.17 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${c['length'] / 2}"/>
        <geometry><cylinder radius="${c['radius']}" length="${c['length']}"/></geometry>
      </collision>
      <collision>
        <origin xyz="0 0 ${c['length'] + b['z'] / 2}"/>
        <geometry><box size="${b['x']} ${b['y']} ${b['z']}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${c['length'] + b['z'] / 2}"/>
        <mass value="${b['mass']}"/>
        <xacro:box_inertia m="${b['mass']}" x="${b['x']}" y="${b['y']}" z="${b['z'] + c['length']}"/>
      </inertial>
    </link>

    <xacro:gripper_finger prefix="${prefix}" side="left" s="1" mimic="${mimic}"/>
    <xacro:gripper_finger prefix="${prefix}" side="right" s="-1" mimic="${mimic}"/>

    <!-- Tool centre point: midway between the pads, at the middle of the pad length.
         Same orientation as tool0: Z = approach direction, Y = closing direction. -->
    <link name="${prefix}gripper_tcp"/>
    <joint name="${prefix}gripper_base-gripper_tcp" type="fixed">
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}gripper_tcp"/>
      <origin xyz="0 0 ${grp['tcp_z']}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
