<?xml version="1.0"?>
<!--
  Top-level GP7 robot description: GP7 arm + Robotiq 2F-85 gripper.

  xacro args:
    gazebo            (true)  include the ros2_control / Gazebo parts (false for RViz-only use)
    controllers_file  ('')    ros2_control controllers yaml (gp7_gazebo/config/controllers.yaml)
-->
<robot name="gp7" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="gazebo" default="true"/>
  <xacro:arg name="controllers_file" default=""/>

  <xacro:include filename="$(find gp7_description)/urdf/gp7_macro.xacro"/>
  <xacro:gp7 prefix=""/>

  <xacro:include filename="$(find gp7_description)/urdf/gripper_robotiq_2f85.xacro"/>
  <xacro:gripper_robotiq_2f85 prefix="" parent="tool0"/>

  <!-- Bolt the robot base to the world origin (0, 0, 0), as the task requires. -->
  <link name="world"/>
  <joint name="world-base_link" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:if value="$(arg gazebo)">
    <xacro:include filename="$(find gp7_description)/urdf/gp7.ros2_control.xacro"/>
    <xacro:gp7_ros2_control prefix="" controllers_file="$(arg controllers_file)"/>
  </xacro:if>
</robot>
