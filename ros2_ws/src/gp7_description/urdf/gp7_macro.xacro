<?xml version="1.0"?>
<!--
  YASKAWA GP7 - kinematic chain + meshes.

  Dimensions : config/kinematics.yaml   (d1 a1 a2 a3 d4 d6)
  Limits     : config/joint_limits.yaml (datasheet ranges / speeds)
  Inertials  : config/inertials.yaml    (generated by tools/prepare_meshes.py)

  All link frames are parallel to base_link at the home pose (all joints 0):
  X forward, Y left, Z up. Meshes are pre-transformed into these frames by
  tools/prepare_meshes.py, so every visual/collision origin is identity.

          joint     parent -> child       origin (in parent)   axis
          joint_1_s base_link -> link_1_s (0, 0, d1)           +Z   S: swivel
          joint_2_l link_1_s  -> link_2_l (a1, 0, 0)           +Y   L: lower arm
          joint_3_u link_2_l  -> link_3_u (0, 0, a2)           -Y   U: upper arm
          joint_4_r link_3_u  -> link_4_r (0, 0, a3)           -X   R: arm roll
          joint_5_b link_4_r  -> link_5_b (d4, 0, 0)           -Y   B: wrist bend
          joint_6_t link_5_b  -> link_6_t (d6, 0, 0)           -X   T: flange
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="pkg" value="gp7_description"/>
  <xacro:property name="kin" value="${xacro.load_yaml('$(find gp7_description)/config/kinematics.yaml')}"/>
  <xacro:property name="lim" value="${xacro.load_yaml('$(find gp7_description)/config/joint_limits.yaml')}"/>
  <xacro:property name="inr" value="${xacro.load_yaml('$(find gp7_description)/config/inertials.yaml')}"/>

  <!-- One link: visual mesh, convex-hull collision mesh, inertial from yaml -->
  <xacro:macro name="gp7_link" params="prefix name rgba">
    <xacro:property name="p" value="${inr[name]}"/>
    <link name="${prefix}${name}">
      <visual>
        <geometry>
          <mesh filename="package://${pkg}/meshes/visual/${name}.stl"/>
        </geometry>
        <material name="${prefix}${name}_material">
          <color rgba="${rgba}"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://${pkg}/meshes/collision/${name}.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${p['com'][0]} ${p['com'][1]} ${p['com'][2]}" rpy="0 0 0"/>
        <mass value="${p['mass']}"/>
        <inertia ixx="${p['ixx']}" ixy="${p['ixy']}" ixz="${p['ixz']}"
                 iyy="${p['iyy']}" iyz="${p['iyz']}" izz="${p['izz']}"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- One revolute joint with datasheet limits -->
  <xacro:macro name="gp7_joint" params="prefix name parent child xyz axis">
    <xacro:property name="l" value="${lim[name]}"/>
    <joint name="${prefix}${name}" type="revolute">
      <parent link="${prefix}${parent}"/>
      <child link="${prefix}${child}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="${axis}"/>
      <limit lower="${radians(l['lower_deg'])}" upper="${radians(l['upper_deg'])}"
             velocity="${radians(l['velocity_deg_s'])}" effort="${l['effort']}"/>
      <dynamics damping="0.5" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="gp7" params="prefix:=''">
    <xacro:property name="blue" value="0.00 0.33 0.71 1.0"/>
    <xacro:property name="grey" value="0.55 0.57 0.60 1.0"/>

    <xacro:gp7_link prefix="${prefix}" name="base_link" rgba="${blue}"/>
    <xacro:gp7_link prefix="${prefix}" name="link_1_s"  rgba="${blue}"/>
    <xacro:gp7_link prefix="${prefix}" name="link_2_l"  rgba="${blue}"/>
    <xacro:gp7_link prefix="${prefix}" name="link_3_u"  rgba="${blue}"/>
    <xacro:gp7_link prefix="${prefix}" name="link_4_r"  rgba="${blue}"/>
    <xacro:gp7_link prefix="${prefix}" name="link_5_b"  rgba="${blue}"/>
    <xacro:gp7_link prefix="${prefix}" name="link_6_t"  rgba="${grey}"/>

    <xacro:gp7_joint prefix="${prefix}" name="joint_1_s" parent="base_link" child="link_1_s"
                     xyz="0 0 ${kin['d1']}" axis="0 0 1"/>
    <xacro:gp7_joint prefix="${prefix}" name="joint_2_l" parent="link_1_s" child="link_2_l"
                     xyz="${kin['a1']} 0 0" axis="0 1 0"/>
    <xacro:gp7_joint prefix="${prefix}" name="joint_3_u" parent="link_2_l" child="link_3_u"
                     xyz="0 0 ${kin['a2']}" axis="0 -1 0"/>
    <xacro:gp7_joint prefix="${prefix}" name="joint_4_r" parent="link_3_u" child="link_4_r"
                     xyz="0 0 ${kin['a3']}" axis="-1 0 0"/>
    <xacro:gp7_joint prefix="${prefix}" name="joint_5_b" parent="link_4_r" child="link_5_b"
                     xyz="${kin['d4']} 0 0" axis="0 -1 0"/>
    <xacro:gp7_joint prefix="${prefix}" name="joint_6_t" parent="link_5_b" child="link_6_t"
                     xyz="${kin['d6']} 0 0" axis="-1 0 0"/>

    <!-- tool0: ROS-Industrial tool frame on the flange face, Z pointing out
         of the flange. A gripper will be attached here later. -->
    <link name="${prefix}tool0"/>
    <joint name="${prefix}link_6_t-tool0" type="fixed">
      <parent link="${prefix}link_6_t"/>
      <child link="${prefix}tool0"/>
      <origin xyz="0 0 0" rpy="0 ${pi/2} 0"/>
    </joint>
  </xacro:macro>
</robot>
