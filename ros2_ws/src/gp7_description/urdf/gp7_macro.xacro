<?xml version="1.0"?>
<!--
  YASKAWA GP7 - kinematic chain built directly from the DH table.

  DH table   : config/kinematics.yaml      (standard DH, classic convention)
  Limits     : config/joint_limits.yaml    (datasheet, mapped to DH joint directions)
  Inertials  : config/inertials.yaml       (generated by tools/prepare_meshes.py)

  Every body link frame IS its DH frame:  base_link = {0},  link_1_s = {1}, ... link_6_t = {6}.
  Meshes are pre-transformed into those frames, so visual/collision origins are identity.

  DH:  A_i = Rz(theta_offset_i + q_i) . Tz(d_i) . Tx(a_i) . Rx(alpha_i)
  Joint i rotates about Z_{i-1}.

  Why the helper frames?  A URDF joint rotates its child about an axis through the
  CHILD's origin. Z_{i-1} passes through O_i only when a_i = 0, so:
   * a_i = 0 (joints 4,5,6): ONE revolute joint.  A_i = [Tz(d) Rz(off) Rx(alpha)] . Rot(k, q)
     with k = Rx(-alpha) z = (0, sin alpha, cos alpha), i.e. Z_{i-1} expressed in {i}.
   * a_i != 0 (joints 1,2,3): split A_i = [Rz(off+q) Tz(d)] . [Tx(a) Rx(alpha)]
       revolute  {i-1} -> joint_i_frame   origin Tz(d) Rz(off), axis z
       fixed     joint_i_frame -> {i}     origin Tx(a) Rx(alpha)
     joint_i_frame is massless; Gazebo merges it with link_i (fixed-joint lumping).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="pkg" value="gp7_description"/>
  <xacro:property name="kin" value="${xacro.load_yaml('$(find gp7_description)/config/kinematics.yaml')}"/>
  <xacro:property name="lim" value="${xacro.load_yaml('$(find gp7_description)/config/joint_limits.yaml')}"/>
  <xacro:property name="inr" value="${xacro.load_yaml('$(find gp7_description)/config/inertials.yaml')}"/>

  <!-- One body: visual mesh, convex-hull collision mesh, inertial from yaml -->
  <xacro:macro name="gp7_link" params="prefix name rgba">
    <xacro:property name="p" value="${inr[name]}"/>
    <link name="${prefix}${name}">
      <visual>
        <geometry>
          <mesh filename="package://${pkg}/meshes/visual/${name}.stl"/>
        </geometry>
        <material name="${prefix}${name}_material">
          <color rgba="${rgba}"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://${pkg}/meshes/collision/${name}.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${p['com'][0]} ${p['com'][1]} ${p['com'][2]}" rpy="0 0 0"/>
        <mass value="${p['mass']}"/>
        <inertia ixx="${p['ixx']}" ixy="${p['ixy']}" ixz="${p['ixz']}"
                 iyy="${p['iyy']}" iyz="${p['iyz']}" izz="${p['izz']}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="joint_limits" params="name">
    <xacro:property name="l" value="${lim[name]}"/>
    <limit lower="${radians(l['lower_deg'])}" upper="${radians(l['upper_deg'])}"
           velocity="${radians(l['velocity_deg_s'])}" effort="${l['effort']}"/>
    <dynamics damping="0.5" friction="0.0"/>
  </xacro:macro>

  <!-- One DH row i: joint i between frame {i-1} (parent) and frame {i} (row['link']) -->
  <xacro:macro name="dh_joint" params="prefix i parent">
    <xacro:property name="r" value="${kin['dh'][i - 1]}"/>
    <xacro:property name="alpha" value="${radians(r['alpha_deg'])}"/>
    <xacro:property name="off" value="${radians(r['theta_offset_deg'])}"/>

    <xacro:if value="${r['a'] == 0}">
      <joint name="${prefix}${r['joint']}" type="revolute">
        <parent link="${prefix}${parent}"/>
        <child link="${prefix}${r['link']}"/>
        <origin xyz="0 0 ${r['d']}" rpy="${alpha} 0 ${off}"/>
        <axis xyz="0 ${round(sin(alpha), 12)} ${round(cos(alpha), 12)}"/>
        <xacro:joint_limits name="${r['joint']}"/>
      </joint>
    </xacro:if>

    <xacro:unless value="${r['a'] == 0}">
      <link name="${prefix}joint_${i}_frame"/>
      <joint name="${prefix}${r['joint']}" type="revolute">
        <parent link="${prefix}${parent}"/>
        <child link="${prefix}joint_${i}_frame"/>
        <origin xyz="0 0 ${r['d']}" rpy="0 0 ${off}"/>
        <axis xyz="0 0 1"/>
        <xacro:joint_limits name="${r['joint']}"/>
      </joint>
      <joint name="${prefix}joint_${i}_frame-${r['link']}" type="fixed">
        <parent link="${prefix}joint_${i}_frame"/>
        <child link="${prefix}${r['link']}"/>
        <origin xyz="${r['a']} 0 0" rpy="${alpha} 0 0"/>
      </joint>
    </xacro:unless>
  </xacro:macro>

  <xacro:macro name="gp7" params="prefix:=''">
    <xacro:property name="blue" value="0.00 0.33 0.71 1.0"/>
    <xacro:property name="grey" value="0.55 0.57 0.60 1.0"/>

    <xacro:gp7_link prefix="${prefix}" name="base_link" rgba="${blue}"/>
    <xacro:gp7_link prefix="${prefix}" name="link_1_s"  rgba="${blue}"/>
    <xacro:gp7_link prefix="${prefix}" name="link_2_l"  rgba="${blue}"/>
    <xacro:gp7_link prefix="${prefix}" name="link_3_u"  rgba="${blue}"/>
    <xacro:gp7_link prefix="${prefix}" name="link_4_r"  rgba="${blue}"/>
    <xacro:gp7_link prefix="${prefix}" name="link_5_b"  rgba="${blue}"/>
    <xacro:gp7_link prefix="${prefix}" name="link_6_t"  rgba="${grey}"/>

    <xacro:dh_joint prefix="${prefix}" i="1" parent="base_link"/>
    <xacro:dh_joint prefix="${prefix}" i="2" parent="link_1_s"/>
    <xacro:dh_joint prefix="${prefix}" i="3" parent="link_2_l"/>
    <xacro:dh_joint prefix="${prefix}" i="4" parent="link_3_u"/>
    <xacro:dh_joint prefix="${prefix}" i="5" parent="link_4_r"/>
    <xacro:dh_joint prefix="${prefix}" i="6" parent="link_5_b"/>

    <!-- tool0: DH frame {6} already has Z out of the flange (ROS-Industrial tool0
         convention), so tool0 coincides with link_6_t. The gripper attaches here. -->
    <link name="${prefix}tool0"/>
    <joint name="${prefix}link_6_t-tool0" type="fixed">
      <parent link="${prefix}link_6_t"/>
      <child link="${prefix}tool0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
