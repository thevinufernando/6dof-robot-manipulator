<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gp7_kinematics</name>
  <version>0.1.0</version>
  <description>Closed-form forward and inverse kinematics of the YASKAWA GP7 with the gripper TCP.</description>
  <maintainer email="user@todo.todo">todo</maintainer>
  <license>MIT</license>

  <exec_depend>gp7_description</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
